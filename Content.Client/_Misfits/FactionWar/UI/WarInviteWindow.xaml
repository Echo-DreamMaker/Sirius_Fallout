<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="War Invitation"
                      Resizable="False"
                      SetSize="440 260"
                      MinSize="400 220">

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="0">

        <controls:StripeBack>
            <PanelContainer>
                <Label Text="War Invitation" StyleClasses="LabelBig" Align="Center" Margin="0 4"/>
            </PanelContainer>
        </controls:StripeBack>

        <RichTextLabel Name="InviteLabel" Margin="10 10 10 8" HorizontalExpand="True"/>

        <PanelContainer MinHeight="1" Modulate="#404040" Margin="10 0"/>

        <BoxContainer Orientation="Horizontal" Margin="10 8 10 6" SeparationOverride="6">
            <Button Name="AcceptButton" Text="Accept" HorizontalExpand="True" Access="Public"/>
            <Button Name="DeclineButton" Text="Decline" HorizontalExpand="True" Access="Public"/>
        </BoxContainer>

        <RichTextLabel Name="ResultLabel" Margin="10 4 10 8" HorizontalExpand="True"/>

    </BoxContainer>
</controls:FancyWindow>
