<DefaultWindow xmlns="https://spacestation14.io"
               Title="Enclave Personnel Control"
               MinWidth="520"
               MinHeight="420"
               SetSize="520 420">
    <BoxContainer Orientation="Vertical" Margin="8">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
            <Label Text="Implanted Personnel"
                   HorizontalExpand="True" />
            <Button Name="RefreshButton"
                    Text="Refresh"
                    MinWidth="90" />
        </BoxContainer>

        <Label Text="WARNING: Detonation commands are immediate and irreversible."
               FontColorOverride="#ff6666"
               Margin="0 0 0 8" />

        <Label Name="EmptyLabel"
               Text="No active Enclave microbomb implants detected."
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               VerticalExpand="True" />

        <ScrollContainer HorizontalExpand="True"
                         VerticalExpand="True">
            <BoxContainer Name="PersonnelList"
                          Orientation="Vertical"
                          HorizontalExpand="True" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
