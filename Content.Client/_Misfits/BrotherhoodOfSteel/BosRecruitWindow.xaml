<DefaultWindow xmlns="https://spacestation14.io"
               Title="AD VIKTORIYA // FIELD RITE"
               MinWidth="700"
               MinHeight="560"
               SetSize="760 620">
    <PanelContainer Name="ScreenPanel">
        <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="8">
            <RichTextLabel Name="TerminalHeader" StyleClasses="monospace" />

            <PanelContainer Name="DocumentPanel" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="16" SeparationOverride="8">
                    <Label Name="PageTitle"
                           StyleClasses="monospace"
                           HorizontalAlignment="Center" />
                    <PanelContainer StyleClasses="PipBoyDivider" MinSize="0 1" />
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                        <RichTextLabel Name="DocumentText"
                                       StyleClasses="monospace"
                                       HorizontalExpand="True" />
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>

            <Label Name="StatusLabel"
                   StyleClasses="monospace"
                   HorizontalAlignment="Center" />

            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <Control HorizontalExpand="True" />
                <Button Name="DeclineButton"
                        Text="DECLINE / WALK AWAY"
                        MinWidth="200" />
                <Button Name="AcceptButton"
                        Text="SWEAR THE OATH // AD VIKTORIYA"
                        MinWidth="250" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
