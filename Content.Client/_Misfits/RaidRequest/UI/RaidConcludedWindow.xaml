<!-- #Misfits Add - Mandatory raid-over acknowledgement window. -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc raid-concluded-window-title}"
                      Resizable="False"
                      SetSize="520 270"
                      MinSize="500 250">

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="0">
        <controls:StripeBack>
            <PanelContainer>
                <Label Text="{Loc raid-concluded-window-title}" StyleClasses="LabelBig" Align="Center" Margin="0 4"/>
            </PanelContainer>
        </controls:StripeBack>

        <RichTextLabel Name="HeaderLabel" Margin="12 14 12 6"
                       HorizontalExpand="True" HorizontalAlignment="Center"/>
        <RichTextLabel Name="PartiesLabel" Margin="12 2 12 10"
                       HorizontalExpand="True" HorizontalAlignment="Center"/>

        <PanelContainer MinHeight="1" Modulate="#603030" Margin="12 0"/>

        <RichTextLabel Text="{Loc raid-concluded-warning}" Margin="14 12 14 12"
                       HorizontalExpand="True" HorizontalAlignment="Center"/>

        <Button Name="AcknowledgeButton" Text="{Loc raid-concluded-acknowledge}"
                Margin="12 4 12 12" HorizontalExpand="True" StyleClasses="OpenBoth"/>
    </BoxContainer>
</controls:FancyWindow>
