<DefaultWindow xmlns="https://spacestation14.io"
                MinSize="700 460"
                SetSize="700 460">
    <BoxContainer Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="5" HorizontalExpand="True">
                <Label Name="HeaderLabel" HorizontalAlignment="Center" />
                <LayoutContainer Name="SlotContainer" MinSize="450 262" HorizontalExpand="True" VerticalExpand="True" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="5" HorizontalExpand="True">
                    <Button Name="BoltButton" HorizontalExpand="True" />
                    <Button Name="DisassembleButton" HorizontalExpand="True" />
                    <Button Name="AssembleButton" HorizontalExpand="True" />
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" Margin="10" MinSize="150 0" SeparationOverride="4">
                <Label Name="RepairLabel" HorizontalAlignment="Center" />
                <Button Name="RepairBodyButton" HorizontalExpand="True" />
                <Button Name="RepairBarrelButton" HorizontalExpand="True" />
                <Button Name="RepairBoltButton" HorizontalExpand="True" />
                <Button Name="RepairGripButton" HorizontalExpand="True" />
                <Button Name="RepairStockButton" HorizontalExpand="True" />
                <!-- #Misfits Add - welding fuel gauge, pinned to the bottom of the column. -->
                <Control VerticalExpand="True" MinHeight="8" />
                <Label Name="FuelLabel" HorizontalAlignment="Center" />
                <ProgressBar Name="FuelBar" MinHeight="16" HorizontalExpand="True" />
                <Label Name="FuelValueLabel" HorizontalAlignment="Center" />
            </BoxContainer>
        </BoxContainer>
        <Button Name="StationCloseButton" Margin="10,0,10,0" HorizontalExpand="True" />
    </BoxContainer>
</DefaultWindow>
